# Only needed for live trading. Paper mode needs none of this.
# Copy to .env (git-ignored). Never commit real keys.

# Private key of the wallet that signs orders.
POLYMARKET_PRIVATE_KEY=

# Optional: the Polymarket account wallet (proxy/deposit wallet) if it differs
# from the default one derived for the signer.
POLYMARKET_WALLET_ADDRESS=

# Second safety latch. Live orders are only sent when this is 1 AND the
# engine is started with --live.
PM_ENABLE_LIVE=0
